# Contact Form Email Configuration (Optional)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address to receive audit/contact form submissions
CONTACT_EMAIL=info@coastalvanguard.com

# Sender address. The onboarding@resend.dev default only delivers to the
# Resend account owner's email — verify the domain in Resend and use e.g.
# "Coastal Vanguard <audits@coastalvanguard.com>" for production.
RESEND_FROM=Coastal Vanguard <onboarding@resend.dev>
